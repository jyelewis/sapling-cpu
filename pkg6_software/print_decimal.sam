// print_decimal
//
// Prints an unsigned 8-bit integer (0-255) as ASCII decimal to DEV7,
// suppressing leading zeros.  CALL with the subroutine address in a
// register pair, e.g.:
//
//     LD R6 >print_decimal
//     LD R7 <print_decimal
//     CALL [R6 R7]
//
// In:        R0 = value to print (0-255)
// Clobbers:  R0-R6
// Returns:   via RET
//
// Implementation: counts how many times 100 and 10 can be subtracted to
// recover the three decimal digits.  CMP is placed directly before each
// conditional branch since flags are only guaranteed across the
// immediately-following ALU instruction.

print_decimal:
    // --- count hundreds: R1 = floor(R0 / 100), R0 -= R1 * 100 ---
    LD R1 0
    LD R3 100
pd_count_hundreds:
    CMP R0 R3
    BCS #pd_done_hundreds       // R0 < 100 → done
    SUB R0 R3
    LD R3 1
    ADD R1 R3
    LD R3 100
    JMP #pd_count_hundreds
pd_done_hundreds:

    // --- count tens: R2 = floor(R0 / 10), R0 -= R2 * 10 ---
    LD R2 0
    LD R4 10
pd_count_tens:
    CMP R0 R4
    BCS #pd_done_tens           // R0 < 10 → done
    SUB R0 R4
    LD R3 1
    ADD R2 R3
    JMP #pd_count_tens
pd_done_tens:

    // R1 = hundreds digit, R2 = tens digit, R0 = ones digit
    LD R6 0x30                  // '0'
    LD R5 0                     // leading-digit-emitted flag

    // --- emit hundreds if non-zero ---
    LD R3 0
    CMP R1 R3
    BEQ #pd_skip_hundreds
    ADD R1 R6
    OUT DEV7 R1
    LD R5 1
pd_skip_hundreds:

    // --- emit tens if non-zero OR hundreds was emitted ---
    LD R3 0
    CMP R5 R3
    BEQ #pd_tens_check_zero     // no leading emitted → check R2
    JMP #pd_print_tens
pd_tens_check_zero:
    LD R3 0
    CMP R2 R3
    BEQ #pd_skip_tens
pd_print_tens:
    ADD R2 R6
    OUT DEV7 R2
pd_skip_tens:

    // --- always emit ones ---
    ADD R0 R6
    OUT DEV7 R0

    RET
